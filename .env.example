# CITYVISION AI - Environment Configuration Template
# Duplicate this file to .env and configure for your local environment.

# General App Settings
APP_NAME=CITYVISION AI
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=true

# Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Database & Storage
# By default, prototype uses local SQLite/GeoJSON. Switch to PostgreSQL/PostGIS when available.
DATABASE_URL=sqlite:///./data/cityvision.db
# DATABASE_URL=postgresql://cityvision:cityvision@localhost:5432/cityvision_db

# Cache & Message Broker (Optional/Future for multi-worker scaling)
REDIS_URL=redis://localhost:6379/0

# Video Ingestion & Stream Settings
MAX_ACTIVE_STREAMS=10
DEFAULT_FRAME_RATE=15
PROCESS_EVERY_N_FRAMES=2
VIDEO_SOURCES_CONFIG=./config/cameras.yaml

# AI Models & Inference Configuration
INFERENCE_DEVICE=cpu
DETECTION_MODEL_PATH=./models/weights/yolov8n.pt
DETECTION_CONFIDENCE_THRESHOLD=0.35
DETECTION_IOU_THRESHOLD=0.45

TRACKER_TYPE=bytetrack
TRACK_BUFFER=30

ANPR_ENABLED=true
# ANPR plate region detector: morphological gradient profiling + EasyOCR
ANPR_DETECTOR=morphological
OCR_CONFIDENCE_THRESHOLD=0.60

REID_ENABLED=true
REID_MODEL_PATH=./models/weights/yolov8n.pt
REID_SIMILARITY_THRESHOLD=0.75
MAX_CROSS_CAMERA_TIME_WINDOW_SEC=300

# Alerts & Watchlist
WATCHLIST_FILE=./data/watchlist/stolen_vehicles.json
ALERT_WEBHOOK_URL=

# Frontend GIS & Google Maps JavaScript API (Place in frontend/.env or here)
VITE_GOOGLE_MAPS_API_KEY=
